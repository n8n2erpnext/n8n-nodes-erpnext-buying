        "parameters": {
          "jsCode": "const docs = {\n  materialRequest: $node['Submit Material Request V2'].json.name,\n  supplierQuotation: $node['Submit Supplier Quotation V2'].json.name,\n  purchaseOrder: $node['Submit Purchase Order V2'].json.name,\n  purchaseReceipt: $node['Submit Purchase Receipt V2'].json.name\n};\nconst serialized = JSON.stringify({ docs, receipt: $node['Submit Purchase Receipt V2'].json });\nconst patterns = [/api[_-]?key/i, /api[_-]?secret/i, /authorization/i, /token\\s+[A-Za-z0-9]/i, /password/i];\nconst securityFindings = patterns.filter((pattern) => pattern.test(serialized)).map((pattern) => pattern.toString());\nreturn [{\n  json: {\n    runId: $node['Build Run Context'].json.runId,\n    status: securityFindings.length === 0 ? 'passed' : 'needs_review',\n    supplier: $node['Build Run Context'].json.supplierName,\n    itemCode: $node['Build Run Context'].json.itemCode,\n    warehouse: $node['Build Run Context'].json.warehouse,\n    qty: $node['Build Run Context'].json.qty,\n    rate: $node['Build Run Context'].json.rate,\n    ...docs,\n    securityFindings,\n    responsePolicy: 'Only document names, procurement totals, and leak-scan status are returned. Credentials and raw upstream errors are not returned by this summary node.'\n  }\n}];"
